# Static asset security; mirrored CSP in index.html is a fallback for other hosts.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://lh3.googleusercontent.com; connect-src 'self' blob: https://api.zippopotam.us https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; worker-src 'self' blob:
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/pkg/*
  Cache-Control: public, max-age=0, must-revalidate
/materials/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/models/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/mobile/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
